# ============================================================================
# Sentinel — Production Environment Variables
# ============================================================================
# Copy this file to .env and replace the values with your production settings.

# ---- Django Core ----
# Generate a new key: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=replace-me-with-a-secure-random-key
DEBUG=False

# ---- Hosts & CORS ----
# Set your backend domain (e.g., sentinel-api.koyeb.app)
ALLOWED_HOSTS=sentinel-api.koyeb.app,localhost,127.0.0.1
# Set your frontend Vercel domain (e.g., https://sentinel.vercel.app)
CORS_ALLOWED_ORIGINS=https://sentinel.vercel.app,http://localhost:5173

# ---- Database (Neon PostgreSQL) ----
DATABASE_URL=postgres://user:password@ep-xxxx.us-east-2.aws.neon.tech/sentinel_db?sslmode=require

# ---- AWS S3 Blob Storage ----
# Get these from: AWS Console → IAM → Create User → Attach S3FullAccess → Create Access Key
USE_S3=True
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_STORAGE_BUCKET_NAME=sentinel-vault
AWS_S3_REGION_NAME=ap-south-1

# ---- Solana RPC ----
# Free dedicated RPC from https://www.helius.dev/ or https://www.alchemy.com/solana
# Using a dedicated RPC avoids rate limits on the public endpoint
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key

# ---- Wallet sessions (optional) ----
# Separate secret for session JWTs; rotating it signs everyone out. Defaults to SECRET_KEY.
# JWT_SECRET=replace-me-with-another-long-random-value
# JWT_LIFETIME_SECONDS=86400
# NONCE_TTL_SECONDS=300
# Host shown in the wallet's sign-in prompt. Requests from CORS_ALLOWED_ORIGINS use their own
# host automatically; this is the fallback. Must be a bare host (Phantom rejects anything else).
SIWS_DOMAIN=sentinel.vercel.app

# ---- Vault (optional) ----
# VAULT_MAX_UPLOAD_BYTES=52428800
# SOLANA_RPC_TIMEOUT=5
# NFT_OWNERSHIP_CACHE_SECONDS=60

# ---- Security hardening (optional) ----
# Move the Django admin off the default /admin/ path
ADMIN_URL=ops-7f3a/
# Comma-separated origins allowed to POST to Django forms (admin) over HTTPS
CSRF_TRUSTED_ORIGINS=https://sentinel-api.koyeb.app
# Enable once you are sure the site is HTTPS-only
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# Rate limits (DRF syntax)
# THROTTLE_ANON=30/minute
# THROTTLE_USER=120/minute
# THROTTLE_AUTH=10/minute
